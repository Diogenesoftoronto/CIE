/* Global Styles */
Screen {
    layout: vertical;
    background: #0D1117; /* GitHub Dimmed bg */
    color: #C9D1D9;      /* GitHub Dimmed fg */
}

/* Top Bar */
#cie_topbar {
    dock: top;
    height: 1;
    background: #161B22;
    border-bottom: solid #30363D;
    color: #8B949E;
    layout: horizontal;
    align: center middle;
    padding: 0 1;
}

.topbar-title {
    width: 35%;
    content-align: left middle;
    text-style: bold;
    color: #F0F6FC;
}

.topbar-status {
    width: 45%;
    content-align: center middle;
}

.topbar-help {
    width: 20%;
    content-align: right middle;
    color: #8B949E;
}

/* Sidebar Layout */
#app-grid {
    layout: horizontal;
    height: 1fr;
    min-height: 0;
}

#sidebar {
    width: 20;
    height: 100%;
    background: #0D1117;
    border-right: solid #30363D;
    dock: left;
}

#sidebar > ListView {
    background: #0D1117;
    border: none;
    height: 100%;
    width: 100%;
}

#sidebar > ListView > ListItem {
    padding: 1 2;
    background: #0D1117;
    color: #8B949E;
}

#sidebar > ListView > ListItem:hover {
    background: #161B22;
    color: #C9D1D9;
}

#sidebar > ListView > ListItem.--highlighted {
    background: #1F6FEB; /* GitHub Blue */
    color: #F0F6FC;
    text-style: bold;
}

#content-area {
    height: 100%;
    width: 1fr;
    background: #0D1117;
}

/* Panels */
.panel {
    background: #0D1117;
    border: none;
    padding: 0;
    height: 100%;
    min-height: 0;
    margin-bottom: 0;
}

.panel-header {
    min-height: 3;
    background: #161B22;
    padding: 0 1;
    border-bottom: solid #30363D;
    layout: horizontal;
    align: center middle;
}

.panel-heading {
    width: 1fr;
}

.panel-subtitle {
    color: #8B949E;
    text-style: italic;
    height: 1;
}

.panel-badge {
    margin-left: 0;
    padding: 0 1;
    border: solid #30363D;
    text-style: bold;
    content-align: center middle;
    background: #161B22;
}

.panel-toolbar {
    width: auto;
    content-align: right middle;
}

.panel-toolbar-button {
    margin-left: 1;
    background: #21262D;
    border: solid #30363D;
    color: #C9D1D9;
    padding: 0 1;
}

.panel-toolbar-button:hover {
    background: #1F6FEB;
    color: #F0F6FC;
    border: solid #1F6FEB;
}

.panel-title {
    text-style: bold;
    content-align: left middle;
    color: #F0F6FC;
}

.panel-content {
    padding: 0 0 0 0; /* Removed padding to let tables fill space */
    height: 1fr;
    min-height: 0;
    background: #0D1117;
}

.panel-status {
    min-height: 1;
    color: #8B949E;
    background: #161B22;
    padding: 0 1;
    border-top: solid #30363D;
    content-align: left middle;
}

/* Data Tables */
.data-table {
    height: 1fr;
    border: none;
    background: #0D1117;
    margin-top: 0;
    min-height: 0;
}

.data-table > .datatable--cursor {
    background: #1F6FEB;
    color: #F0F6FC;
}

.data-table > .datatable--header {
    background: #161B22;
    color: #8B949E;
    text-style: bold;
    border-bottom: solid #30363D;
}

/* Inputs */
Input {
    background: #0D1117;
    border: solid #30363D;
    color: #C9D1D9;
}

Input:focus {
    border: solid #1F6FEB;
}

TextArea {
    background: #0D1117;
    border: solid #30363D;
    color: #C9D1D9;
}

TextArea:focus {
    border: solid #1F6FEB;
}

/* Status Bar */
.status-bar {
    background: #161B22;
    border-top: solid #30363D;
    padding: 0 1;
    height: 1;
    dock: bottom;
}

.status-message {
    width: 1fr;
    color: #8B949E;
}

/* Modals */
.modal-buttons Button {
    background: #21262D;
    border: solid #30363D;
    color: #C9D1D9;
}

.modal-buttons Button:hover {
    background: #1F6FEB;
    color: #F0F6FC;
}

#command-palette,
#tutor-modal,
#help-modal,
#context-tools-modal {
    background: #0D1117;
    border: solid #30363D;
    padding: 1;
}

/* Context Panel Specifics */
.context-tree-panel,
.context-details-panel,
.context-metrics-panel {
    background: #0D1117;
    border: solid #30363D;
    padding: 0 1;
    height: 1fr;
    min-height: 0;
}

/* Charts & Metrics */
.chart-widget,
.chart-canvas,
.metric-grid,
.system-metrics-panel {
    background: #0D1117;
    border: solid #30363D;
}

.metric-card {
    background: #161B22;
    border: solid #30363D;
    padding: 0 1;
}

.metric-card-value {
    text-style: bold;
    color: #F0F6FC;
}

.metric-card-delta {
    color: #8B949E;
}

/* Scrollbars */
ScrollBar {
    background: #0D1117;
    color: #30363D;
}

ScrollBar:hover {
    color: #8B949E;
}
