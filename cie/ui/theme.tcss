Screen {
    layout: vertical;
    background: #111417;
    color: #e4e8ef;
}

Header,
Footer {
    background: #1a1f24;
    color: #e4e8ef;
    height: 3;
    border: none;
    content-align: left middle;
}

TabbedContent {
    height: 1fr;
    min-height: 0;
    padding: 0 1 1 1;
}

TabbedContent Tabs {
    background: #14191d;
    border-bottom: solid #23282f;
}

TabbedContent Tab {
    color: #7e8b9c;
    padding: 0 1;
}

TabbedContent Tab.--active {
    color: #61d6ff;
    text-style: bold;
    border-bottom: solid #61d6ff;
}

TabPane {
    height: 1fr;
    min-height: 0;
    padding: 1 0 0 0;
}

.panel {
    background: #12171b;
    border: solid #1f242a;
    padding: 0;
    height: 1fr;
    min-height: 0;
}

.panel-header {
    height: 3;
    background: #181d22;
    padding: 0 1;
    border-bottom: solid #20252c;
    layout: horizontal;
    align: center middle;
}

.panel-control {
    width: 2;
    height: 1;
    margin-right: 1;
    padding: 0;
    background: #1e2329;
    color: #cfd7e3;
    border: solid #2a3037;
    content-align: center middle;
}

.panel-control:hover {
    background: #61d6ff;
    color: #101316;
    border: solid #61d6ff;
}

.panel-title {
    text-style: bold;
    content-align: left middle;
    color: #e4e8ef;
}

.panel-content {
    padding: 1 1 1 1;
    height: 1fr;
    min-height: 0;
}

.panel-status {
    min-height: 1;
    color: #9aa5b5;
    background: #14191d;
    padding: 0 1;
    border-top: solid #1f242a;
    content-align: left middle;
}

.data-table {
    height: 1fr;
    border: solid #1f242a;
    background: #14181c;
    margin-top: 1;
}

.data-table > .datatable--cursor {
    background: #2a3037;
    color: #e4e8ef;
}

ListView {
    border: solid #1f242a;
    background: #14181c;
}

ListView > ListItem.--highlighted {
    background: #2a3037;
}

Input {
    background: #1c2025;
    border: solid #2b323a;
    color: #e4e8ef;
}

Input:focus {
    border: solid #61d6ff;
}

#status_panel {
    border-top: solid #1f242a;
    padding: 1 1;
    background: #101417;
}

.help-text {
    color: #d8dde6;
}

.modal-buttons Button {
    background: #1f242a;
    border: solid #2a3037;
    color: #e4e8ef;
}

.modal-buttons Button:hover {
    background: #61d6ff;
    color: #101316;
}

#command-palette,
#tutor-modal,
#help-modal {
    background: #111518;
    border: solid #1f242a;
    padding: 1;
}
